      "Black": { "$type": "color", "$value": "#000000" },
      "White": { "$type": "color", "$value": "#ffffff" }
    },
    "Blue": {
      "100": { "$type": "color", "$value": "#dcdcf6" },
      "200": { "$type": "color", "$value": "#b2b2ff" },
      "300": { "$type": "color", "$value": "#0000ff", "$description": "Primary brand color. Header text, primary buttons, text-links." },
      "900": { "$type": "color", "$value": "{Cashalo.Blue.300}", "$description": "DEPRECATED — use Cashalo.Blue.300. Temporary alias for v1 → v2 migration." }
    },
    "Gold": {
      "100": { "$type": "color", "$value": "#f8dfac" },
      "200": { "$type": "color", "$value": "#fad17b" },
      "300": { "$type": "color", "$value": "#ffad02", "$description": "Highlighting active states, selected radios, checked boxes." }
