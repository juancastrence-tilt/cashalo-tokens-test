  "semantic": {
    "brand": {
      "primary":   { "$type": "color", "$value": "{Cashalo.Blue.300}", "$description": "Primary brand color." },
      "secondary": { "$type": "color", "$value": "{Cashalo.Gold.300}", "$description": "Secondary brand color." }
    },
    "text": {
      "header":      { "$type": "color", "$value": "{Cashalo.Shades.900}",  "$description": "Section headers and titles." },
      "body":        { "$type": "color", "$value": "{Cashalo.Shades.600}",  "$description": "Default body and paragraph text." },
      "secondary":   { "$type": "color", "$value": "{Cashalo.Misc.Shadow}", "$description": "Supporting text, metadata, captions." },
      "interactive": { "$type": "color", "$value": "{Cashalo.Blue.300}",    "$description": "Links and clickable text." },
      "disabled":    { "$type": "color", "$value": "{Cashalo.Misc.Silver}", "$description": "Disabled / unavailable text." },
      "muted":       { "$type": "color", "$value": "#000000",               "$description": "Muted black text." },
      "tab-inactive":{ "$type": "color", "$value": "{Cashalo.Misc.Ash}",    "$description": "Inactive tab label." },
      "tab-active":  { "$type": "color", "$value": "{Cashalo.Shades.900}",  "$description": "Active tab label." }
    },
    "icons": {
      "neutral":          { "$type": "color", "$value": "{Cashalo.Misc.Ash}",  "$description": "Default icon color." },
      "nav-neutral":      { "$type": "color", "$value": "{Cashalo.Blue.200}", "$description": "Inactive bottom-nav icons." },
      "nav-highlighted":  { "$type": "color", "$value": "{Cashalo.Blue.300}", "$description": "Active bottom-nav icon." }
    },
    "buttons": {
      "fill": {
        "primary":         { "$type": "color", "$value": "{Cashalo.Blue.300}",   "$description": "Primary button fill." },
        "secondary":       { "$type": "color", "$value": "{Cashalo.Greys.500}",  "$description": "Secondary button fill." },
        "modal-primary":   { "$type": "color", "$value": "{Cashalo.Shades.900}", "$description": "Primary button in modals." },
        "modal-secondary": { "$type": "color", "$value": "{Cashalo.Misc.Pure}",  "$description": "Secondary button in modals." },
        "button-text":     { "$type": "color", "$value": "{Cashalo.Base.White}", "$description": "Text/icon color on filled buttons." }
      }
    },
    "field": {
      "fill":            { "$type": "color", "$value": "{Cashalo.Misc.Silver}", "$description": "Input field background." },
      "text":            { "$type": "color", "$value": "{Cashalo.Misc.Ash}",    "$description": "Input field text." },
      "outline-focus":   { "$type": "color", "$value": "{Cashalo.Blue.200}",    "$description": "Outline color when focused." },
      "outline-neutral": { "$type": "color", "$value": "#dbf0f6",               "$description": "Default outline color." }
    },
    "surface": {
      "card":           { "$type": "color", "$value": "{Cashalo.Base.White}",      "$description": "Card background." },
      "screen":         { "$type": "color", "$value": "{semantic.surface.card}",   "$description": "Default screen background." },
      "secondary":      { "$type": "color", "$value": "{Cashalo.Gold.300}",        "$description": "Secondary brand surface." },
      "radio":          { "$type": "color", "$value": "#dbf0f6",                   "$description": "Idle radio background." },
      "radio-selected": { "$type": "color", "$value": "{semantic.buttons.fill.primary}", "$description": "Selected radio fill." }
    },
    "outline": {
      "neutral":  { "$type": "color", "$value": "#d9d9d9",            "$description": "Default neutral border." },
      "selected": { "$type": "color", "$value": "{Cashalo.Gold.300}", "$description": "Selected/active border." }
    }
  },
  "bottomNavShadow": {
    "$type": "boxShadow",
    "$value": { "color": "#64646f0d", "type": "dropShadow", "x": 0, "y": -7, "blur": 20, "spread": 0 },
    "$description": "For bottom navs."
  },
  "cardShadow": {
    "cardShadow": {
      "$type": "boxShadow",
      "$value": { "color": "#64646f12", "type": "dropShadow", "x": 0, "y": 7, "blur": 20, "spread": 0 },
      "$description": "For cards."
    }
  },
